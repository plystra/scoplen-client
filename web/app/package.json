{
  "name": "@scoplen/app",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @scoplen/terminal build",
    "dev": "vite",
    "prebuild": "pnpm --filter @scoplen/terminal build",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "pnpm --filter @scoplen/terminal build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @scoplen/terminal build",
    "test": "vitest run"
  },
  "dependencies": {
    "@scoplen/ui": "workspace:*",
    "@scoplen/terminal": "workspace:*",
    "@tauri-apps/api": "2.12.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
